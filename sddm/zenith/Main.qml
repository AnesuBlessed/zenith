// =============================================================================
//  ZENITH — SDDM GREETER
//
//  Silent-inspired login card on Zenith's shared generated wallpaper:
//  avatar, editable user, password/login pill, bottom session and power
//  popups, and a quiet right-hand clock. All text uses Zenith Display except
//  Nerd-font status glyphs. Colors, background, avatar and status strings are
//  generated by the Rust engine and mirrored into /var/lib/zenith.
// =============================================================================

import QtQuick
import QtQml

Rectangle {
    id: root

    color: "#121217"

    readonly property string displayFont: "Zenith Display"
    readonly property string statusFont: "JetBrainsMono Nerd Font"

    function fade(value, alpha) {
        return Qt.rgba(value.r, value.g, value.b, alpha)
    }

    // ---------------------------------------------------------------------
    // Small controls. Declared first so they are available everywhere below.
    // ---------------------------------------------------------------------
    component PillButton: Rectangle {
        id: pill
        signal activated()
        property string label: ""
        property bool prominent: false
        property color accentColor: "#c7c3ff"
        property color surfaceColor: "#2a2931"
        property color textColor: "#e6e1e9"
        property color onAccent: "#121217"
        property string fontFamily: "Zenith Display"

        width: pillLabel.implicitWidth + 34
        height: 36
        radius: 18
        color: pill.prominent
            ? pill.accentColor
            : (pillMouse.containsMouse
                ? Qt.rgba(pill.accentColor.r, pill.accentColor.g,
                    pill.accentColor.b, 0.22)
                : Qt.rgba(pill.surfaceColor.r, pill.surfaceColor.g,
                    pill.surfaceColor.b, 0.72))
        border.width: pill.prominent ? 0 : 1
        border.color: Qt.rgba(pill.accentColor.r, pill.accentColor.g,
            pill.accentColor.b, 0.28)

        Text {
            id: pillLabel
            anchors.centerIn: parent
            text: pill.label
            color: pill.prominent ? pill.onAccent : pill.textColor
            font.family: pill.fontFamily
            font.pixelSize: 13
        }

        MouseArea {
            id: pillMouse
            anchors.fill: parent
            enabled: pill.enabled
            hoverEnabled: true
            cursorShape: Qt.PointingHandCursor
            onClicked: pill.activated()
        }
    }

    component SessionRow: Rectangle {
        id: sessionRow
        signal selected()
        property string label: ""
        property bool current: false
        property color accentColor: "#c7c3ff"
        property color textColor: "#e6e1e9"
        property string fontFamily: "Zenith Display"

        width: 216
        height: 30
        radius: 10
        color: sessionRow.current
            ? Qt.rgba(sessionRow.accentColor.r, sessionRow.accentColor.g,
                sessionRow.accentColor.b, 0.24)
            : Qt.rgba(sessionRow.accentColor.r, sessionRow.accentColor.g,
                sessionRow.accentColor.b, 0.06)
        border.width: 0

        Text {
            anchors.centerIn: parent
            text: sessionRow.label
            color: sessionRow.textColor
            font.family: sessionRow.fontFamily
            font.pixelSize: 12
        }

        MouseArea {
            anchors.fill: parent
            cursorShape: Qt.PointingHandCursor
            onClicked: sessionRow.selected()
        }
    }

    // ---------------------------------------------------------------------
    // Shared generated palette. Installer seeds this on first boot and
    // zenith-native rewrites it whenever wallpaper/palette changes.
    // ---------------------------------------------------------------------
    Loader {
        id: paletteSource
        source: "file:///var/lib/zenith/palette.qml"
    }

    readonly property color accent: paletteSource.item
        ? paletteSource.item.accent : "#c7c3ff"
    readonly property color surface: paletteSource.item
        ? paletteSource.item.surface : "#2a2931"
    readonly property color textColor: paletteSource.item
        ? paletteSource.item.onSurface : "#e6e1e9"
    readonly property color muted: paletteSource.item
        ? paletteSource.item.onSurfaceVariant : "#c9c5cf"
    readonly property color critical: paletteSource.item
        ? paletteSource.item.error : "#ffb4ab"
    readonly property color outline: paletteSource.item
        ? paletteSource.item.outlineVariant : "#48464f"

    // Status snapshot written by scripts/lock-status.sh before locking and at
    // install time. Missing file simply yields empty strings.
    Loader {
        id: statusSource
        source: "file:///var/lib/zenith/lock-status.qml"
    }
    readonly property var status: statusSource.item

    // ---------------------------------------------------------------------
    // Background: the exact same processed image hyprlock uses.
    // ---------------------------------------------------------------------
    Image {
        anchors.fill: parent
        source: "file:///var/lib/zenith/lock-bg.png"
        fillMode: Image.PreserveAspectCrop
        cache: false
    }

    // A very light veil keeps glass panels readable without hiding the art.
    Rectangle {
        anchors.fill: parent
        color: root.fade(root.surface, 0.16)
    }

    property date now: new Date()
    Timer {
        interval: 1000
        running: true
        repeat: true
        onTriggered: root.now = new Date()
    }

    // ---------------------------------------------------------------------
    // SDDM session/user contract
    // ---------------------------------------------------------------------
    property var sessionNames: []
    property int sessionIndex: Math.max(0, sessionModel.lastIndex)
    property bool authenticating: false
    property string loginError: ""

    readonly property int selectedSessionIndex: sessionNames.length === 0
        ? 0
        : Math.max(0, Math.min(sessionIndex, sessionNames.length - 1))

    readonly property string currentSession: sessionNames.length === 0
        ? ""
        : String(sessionNames[selectedSessionIndex].name || "")

    readonly property string currentSessionLabel: {
        const value = root.currentSession
        if (!value)
            return "Hyprland"
        const base = value.split("/").pop()
            .replace(/\.desktop$/, "")
            .split(" ").pop()
        return base.charAt(0).toUpperCase() + base.slice(1)
    }

    function registerSession(name, comment) {
        if (!name)
            return
        for (let i = 0; i < sessionNames.length; i++) {
            if (sessionNames[i].name === name)
                return
        }
        sessionNames.push({ name: name, comment: comment || "" })
    }

    function attemptLogin() {
        if (root.authenticating)
            return
        if (passwordInput.text === "") {
            passwordInput.forceActiveFocus()
            return
        }
        root.loginError = ""
        root.authenticating = true
        // SDDM 0.21 expects an integer model index, not a session name.
        sddm.login(usernameInput.text, passwordInput.text,
            root.selectedSessionIndex)
    }

    Component.onCompleted: {
        usernameInput.text = userModel.lastUser || ""
        passwordInput.forceActiveFocus()
    }

    Connections {
        target: sddm
        onLoginFailed: {
            root.authenticating = false
            root.loginError = "wrong password"
            passwordInput.text = ""
            passwordInput.forceActiveFocus()
        }
        onLoginSucceeded: {
            root.authenticating = true
            root.loginError = ""
        }
        onInformationMessage: function (message) {
            root.loginError = String(message || "")
        }
    }

    // SDDM models are QAbstractListModel instances; delegates register their
    // roles because QML cannot call .get() on them directly.
    Repeater {
        model: sessionModel
        delegate: Item {
            Component.onCompleted: root.registerSession(
                model.name || "", model.comment || "")
        }
    }

    // ---------------------------------------------------------------------
    // Top status — same anchors as hyprlock.conf
    // ---------------------------------------------------------------------
    Text {
        anchors.left: parent.left
        anchors.leftMargin: 36
        anchors.top: parent.top
        anchors.topMargin: 32
        text: root.status ? root.status.weather : ""
        color: root.textColor
        font.family: root.statusFont
        font.pixelSize: 13
    }

    Text {
        anchors.right: parent.right
        anchors.rightMargin: 120
        anchors.top: parent.top
        anchors.topMargin: 32
        text: root.status ? root.status.wifi : ""
        color: root.muted
        font.family: root.statusFont
        font.pixelSize: 12
    }

    Text {
        anchors.right: parent.right
        anchors.rightMargin: 36
        anchors.top: parent.top
        anchors.topMargin: 32
        text: root.status ? root.status.battery : ""
        color: root.textColor
        font.family: root.statusFont
        font.pixelSize: 12
    }

    // ---------------------------------------------------------------------
    // Right-hand clock — keeps parity with the hyprlock column.
    // ---------------------------------------------------------------------
    Text {
        anchors.right: parent.right
        anchors.rightMargin: 90
        anchors.verticalCenter: parent.verticalCenter
        anchors.verticalCenterOffset: 112
        text: Qt.formatDate(root.now, "dddd, MMMM d")
        color: root.muted
        font.family: root.displayFont
        font.pixelSize: 20
    }

    Text {
        anchors.right: parent.right
        anchors.rightMargin: 90
        anchors.verticalCenter: parent.verticalCenter
        anchors.verticalCenterOffset: 190
        text: Qt.formatTime(root.now, "HH:mm")
        color: root.textColor
        font.family: root.displayFont
        font.pixelSize: 104
    }

    Text {
        anchors.right: parent.right
        anchors.rightMargin: 8
        anchors.verticalCenter: parent.verticalCenter
        anchors.verticalCenterOffset: 262
        text: root.now.getHours() < 12 ? "AM" : "PM"
        color: root.muted
        font.family: root.displayFont
        font.pixelSize: 22
    }

    Text {
        anchors.right: parent.right
        anchors.rightMargin: 90
        anchors.verticalCenter: parent.verticalCenter
        anchors.verticalCenterOffset: 42
        text: root.status ? root.status.media : ""
        color: root.muted
        font.family: root.statusFont
        font.pixelSize: 11
        elide: Text.ElideRight
        maximumLineCount: 1
    }

    // ---------------------------------------------------------------------
    // Centered glass login card — SilentSDDM-inspired structure, Zenith look.
    // ---------------------------------------------------------------------
    Item {
        id: loginCard
        width: 420
        height: 300
        anchors.centerIn: parent

        Rectangle {
            anchors.fill: parent
            radius: 28
            color: root.fade(root.surface, 0.78)
            border.width: 1
            border.color: root.fade(root.accent, 0.22)
        }

        Image {
            width: 104
            height: 104
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            anchors.topMargin: 26
            source: "avatar.png"
            fillMode: Image.PreserveAspectFit
        }

        Image {
            width: 104
            height: 104
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            anchors.topMargin: 26
            source: "file:///var/lib/zenith/avatar.png"
            fillMode: Image.PreserveAspectFit
            cache: false
        }

        Rectangle {
            id: usernamePill
            width: 248
            height: 32
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            anchors.topMargin: 140
            radius: 16
            color: root.fade(root.surface, 0.45)
            border.width: 1
            border.color: root.fade(root.accent, 0.14)

            TextInput {
                id: usernameInput
                anchors.fill: parent
                anchors.leftMargin: 14
                anchors.rightMargin: 14
                verticalAlignment: TextInput.AlignVCenter
                color: root.muted
                font.family: root.displayFont
                font.pixelSize: 13
                clip: true
                selectByMouse: true
                enabled: !root.authenticating
                KeyNavigation.tab: passwordInput
                Keys.onReturnPressed: root.attemptLogin()
                Keys.onEnterPressed: root.attemptLogin()

                Text {
                    anchors.fill: parent
                    verticalAlignment: Text.AlignVCenter
                    text: "user"
                    color: root.fade(root.muted, 0.62)
                    font.family: root.displayFont
                    font.pixelSize: 13
                    visible: usernameInput.text.length === 0
                }
            }
        }

        Rectangle {
            id: passwordPill
            width: 332
            height: 48
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: usernamePill.bottom
            anchors.topMargin: 12
            radius: 24
            color: root.fade(root.surface, 0.88)
            border.width: 1
            border.color: root.loginError !== ""
                ? root.fade(root.critical, 0.72)
                : root.fade(root.accent, 0.34)

            TextInput {
                id: passwordInput
                anchors.fill: parent
                anchors.leftMargin: 20
                anchors.rightMargin: 96
                verticalAlignment: TextInput.AlignVCenter
                color: root.textColor
                // Zenith Display is Latin-first; the Nerd font supplies masks.
                font.family: root.statusFont
                font.pixelSize: 14
                clip: true
                echoMode: TextInput.Password
                passwordCharacter: "●"
                enabled: !root.authenticating
                KeyNavigation.backtab: usernameInput
                Keys.onReturnPressed: root.attemptLogin()
                Keys.onEnterPressed: root.attemptLogin()

                Text {
                    anchors.fill: parent
                    verticalAlignment: Text.AlignVCenter
                    text: "Password"
                    color: root.fade(root.muted, 0.66)
                    font.family: root.displayFont
                    font.pixelSize: 13
                    visible: passwordInput.text.length === 0
                }
            }

            PillButton {
                anchors.right: parent.right
                anchors.rightMargin: 5
                anchors.verticalCenter: parent.verticalCenter
                label: "Login"
                prominent: true
                accentColor: root.accent
                surfaceColor: root.surface
                textColor: root.textColor
                onAccent: root.fade(root.surface, 0.92)
                enabled: !root.authenticating
                onActivated: root.attemptLogin()
            }
        }

        Text {
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: passwordPill.bottom
            anchors.topMargin: 14
            text: root.authenticating
                ? "signing in..."
                : root.loginError
            color: root.authenticating ? root.muted : root.critical
            font.family: root.displayFont
            font.pixelSize: 12
            visible: root.authenticating || root.loginError !== ""
        }
    }

    // ---------------------------------------------------------------------
    // Bottom-left session popup.
    // ---------------------------------------------------------------------
    Item {
        id: sessionButton
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        anchors.margins: 28
        width: 216
        height: 32

        Rectangle {
            anchors.fill: parent
            radius: 16
            color: root.fade(root.surface, 0.58)
            border.width: 1
            border.color: root.fade(root.accent, 0.20)
        }

        Text {
            anchors.left: parent.left
            anchors.leftMargin: 14
            anchors.verticalCenter: parent.verticalCenter
            text: root.currentSessionLabel
            color: root.muted
            font.family: root.displayFont
            font.pixelSize: 12
        }

        Text {
            anchors.right: parent.right
            anchors.rightMargin: 14
            anchors.verticalCenter: parent.verticalCenter
            text: sessionPopup.visible ? "-" : "+"
            color: root.accent
            font.family: root.statusFont
            font.pixelSize: 14
        }

        MouseArea {
            anchors.fill: parent
            cursorShape: Qt.PointingHandCursor
            onClicked: {
                powerMenu.visible = false
                sessionPopup.visible = !sessionPopup.visible
            }
        }
    }

    Column {
        id: sessionPopup
        visible: false
        z: 3
        anchors.left: sessionButton.left
        anchors.bottom: sessionButton.top
        anchors.bottomMargin: 8
        spacing: 4

        Repeater {
            model: sessionNames
            delegate: SessionRow {
                label: modelData.comment || modelData.name || ""
                current: index === root.selectedSessionIndex
                accentColor: root.accent
                textColor: root.textColor
                onSelected: {
                    root.sessionIndex = index
                    sessionPopup.visible = false
                }
            }
        }
    }

    // ---------------------------------------------------------------------
    // Bottom-right power popup.
    // ---------------------------------------------------------------------
    Item {
        id: powerButton
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        anchors.margins: 28
        width: 92
        height: 34

        PillButton {
            anchors.fill: parent
            label: "Power"
            accentColor: root.accent
            surfaceColor: root.surface
            textColor: root.textColor
            onActivated: {
                sessionPopup.visible = false
                powerMenu.visible = !powerMenu.visible
            }
        }
    }

    Column {
        id: powerMenu
        visible: false
        z: 3
        anchors.right: powerButton.right
        anchors.bottom: powerButton.top
        anchors.bottomMargin: 8
        spacing: 4

        PillButton {
            label: "Suspend"
            visible: sddm.canSuspend
            accentColor: root.accent
            surfaceColor: root.surface
            textColor: root.textColor
            onActivated: {
                powerMenu.visible = false
                sddm.suspend()
            }
        }

        PillButton {
            label: "Reboot"
            visible: sddm.canReboot
            accentColor: root.accent
            surfaceColor: root.surface
            textColor: root.textColor
            onActivated: {
                powerMenu.visible = false
                sddm.reboot()
            }
        }

        PillButton {
            label: "Shutdown"
            visible: sddm.canPowerOff
            accentColor: root.accent
            surfaceColor: root.surface
            textColor: root.textColor
            onActivated: {
                powerMenu.visible = false
                sddm.powerOff()
            }
        }
    }
}
