{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/zenith/fastfetch/zenith-logo.txt",
    "type": "file",
    "color": {
      "1": "magenta",
      "2": "cyan"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ❯ "
  },
  "modules": [
    {
      "type": "custom",
      "format": "  󰣇 ❯ Zenith — Hyprland Workstation"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────────────────"
    },
    {
      "type": "os",
      "key": "  󰌽 OS",
      "format": "{2}",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "  󰌢 Kernel",
      "format": "{2}",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "format": "{1}x{2} @ {3}Hz",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "  󰞷 Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "  󱂬 WM",
      "format": "{2}",
      "keyColor": "magenta"
    },
    {
      "type": "cpu",
      "key": "  󰻠 CPU",
      "format": "{1}",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "  󰑭 Memory",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "  󱎫 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────────────────"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
